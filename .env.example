# AgentForge configuration. Copy to .env (scripts/dev-setup.sh does this only when .env is absent) and keep it
# private: chmod 600 .env. apps/api/src/agentforge/settings.py is the contract; precedence is the process
# environment, then apps/api/.env, then this root .env. Empty values are ignored (the default applies).
# Commented lines show the default. Check your setup with: cd apps/api && uv run python -m agentforge.doctor
#
# The web app reads one setting of its own, from apps/web/.env.local (not this file):
#   API_ORIGIN=http://localhost:8000   server-side origin the Next.js /api rewrite forwards to

# --- Core (required) ---------------------------------------------------------------------------------
# development | test | production. Production requires https URLs and AUTH_MODE=github_app.
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_PUBLIC_BASE_URL=http://localhost:8000
# Comma-separated browser origins allowed to call the API. Defaults to the origin of APP_BASE_URL.
# ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+psycopg://agentforge:change-me@localhost:5432/agentforge
# Private artifact storage directory (default: <repo>/.local/artifacts).
# RESEARCH_STORAGE_PATH=

# --- Sign-in ------------------------------------------------------------------------------------------
# disabled | local_single_user | github_app. For local development, run
#   cd apps/api && uv run python -m agentforge.auth.bootstrap --write-env
# which creates the local identity and fills the three empty values below (it never overwrites a value).
AUTH_MODE=
LOCAL_USER_ID=
# At least 32 characters; you type it once in the browser to sign in.
LOCAL_BOOTSTRAP_TOKEN=
# Local sign-in lasts this long (seconds; max 7 days).
# LOCAL_SESSION_TTL_SEC=86400
# GitHub sign-in: a session ends after this long, or after this long without use.
# SESSION_ABSOLUTE_TTL_SEC=604800
# SESSION_IDLE_TTL_SEC=86400
# Comma-separated GitHub logins who may sign in (case-insensitive); they get an account on first sign-in.
# Empty means no allowlist: existing accounts, plus anyone while PUBLIC_SIGNUP_ENABLED=true.
# GITHUB_ALLOWED_LOGINS=
# PUBLIC_SIGNUP_ENABLED=true

# --- GitHub App (sign-in and private repositories; see docs/github-app.md) --------------------------------
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# At least 32 random characters; encrypts stored GitHub tokens. Changing it signs every user out of GitHub.
# (ENCRYPTION_KEY is accepted as an alias.)
# GITHUB_TOKEN_ENCRYPTION_KEY=
# At least 32 random characters; must match the App's webhook secret.
# GITHUB_WEBHOOK_SECRET=
# Default: API_PUBLIC_BASE_URL + /api/v1/auth/github/callback
# GITHUB_OAUTH_CALLBACK_URL=
# Lets the agent open draft pull requests.
# ENABLE_GITHUB_WRITES=false
# GITHUB_API_VERSION=2026-03-10

# --- Model (required to chat) ----------------------------------------------------------------------------
# An OpenAI-compatible provider. Verify the model's tool support, context window and current prices.
# LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
LLM_SUPPORTS_TOOLS=true
LLM_SUPPORTS_JSON=true
LLM_CONTEXT_WINDOW_TOKENS=
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
# Only for models priced differently above a long-context threshold.
# LLM_LONG_CONTEXT_INPUT_USD_PER_MILLION=
# LLM_LONG_CONTEXT_OUTPUT_USD_PER_MILLION=
# none | minimal | low | medium | high | xhigh (unset: the provider default)
# LLM_REASONING_EFFORT=
# LLM_MAX_OUTPUT_TOKENS=16384
# LLM_TIMEOUT_SEC=180
# LLM_MAX_RETRIES=4
# LLM_PARALLEL_TOOL_CALLS=true
# LLM_STRICT_TOOLS=false

# --- Optional tools -----------------------------------------------------------------------------------
# Web search (Tavily).
# TAVILY_API_KEY=
# TAVILY_USD_PER_CREDIT=
# TAVILY_SEARCH_MAX_COST_USD=0.02
# Page fetching.
# RESEARCH_FETCH_TIMEOUT_SEC=15
# RESEARCH_MAX_RESPONSE_BYTES=1000000
# Coding sandbox (E2B): bash, files and search. The template is optional.
# E2B_API_KEY=
# E2B_TEMPLATE_ID=
# E2B_REQUEST_TIMEOUT_SEC=30
# E2B_SANDBOX_TTL_SEC=3600
# Tracing (Neatlogs).
# NEATLOGS_API_KEY=
# NEATLOGS_WORKFLOW_NAME=agentforge-ai

# --- Worker and conversations ---------------------------------------------------------------------------
# WORKER_LEASE_SEC=90
# WORKER_HEARTBEAT_SEC=10
# WORKER_POLL_SEC=2
# Tasks one worker runs at once.
# WORKER_CONCURRENCY=4
# Seconds a stopping worker lets running tasks finish.
# WORKER_DRAIN_SEC=25
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=10
# CONVERSATION_QUEUE_ENABLED=true
# CONVERSATION_SUMMARIES_ENABLED=true
# CONVERSATION_TITLES_ENABLED=true

# --- Release checks only (scripts/release_checks.py) ----------------------------------------------------------
# Administrative URL used to create and drop disposable test databases.
# TEST_DATABASE_ADMIN_URL=
