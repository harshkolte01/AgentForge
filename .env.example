# AgentForge local configuration. Copy to .env (scripts/dev-setup.sh does this only when .env is absent), keep it private
# (chmod 600) and never commit it. This file holds only what you must or may set: every other setting has a safe default.
# The full reference (URLs, limits, GitHub App, tuning) is docs/configuration.md. Check your setup with:
#   cd apps/api && uv run python -m agentforge.doctor

# --- Database (required) ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://agentforge:change-me@localhost:5432/agentforge

# --- Sign-in (required) ----------------------------------------------------------------------------
# Leave these three empty: `cd apps/api && uv run python -m agentforge.auth.bootstrap --write-env` creates your local
# identity and fills them (it never overwrites a value). You type LOCAL_BOOTSTRAP_TOKEN once in the browser to sign in.
AUTH_MODE=
LOCAL_USER_ID=
LOCAL_BOOTSTRAP_TOKEN=

# --- Model (required to chat) ----------------------------------------------------------------------
# An OpenAI-compatible provider. Take the context window and prices from your provider's current model page.
LLM_MODEL=
LLM_API_KEY=
LLM_SUPPORTS_TOOLS=true
LLM_SUPPORTS_JSON=true
LLM_CONTEXT_WINDOW_TOKENS=
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=

# --- Optional: each key switches one capability on --------------------------------------------------
# Web search. Exa is used first; Tavily is the fallback when Exa is unavailable. Either key alone also works.
# Each takes one key or several separated by commas (EXA_API_KEY=key1,key2): they are used in order, and a key that is
# expired, out of credit or rate limited is skipped for a while in favour of the next.
# EXA_API_KEY=
# EXA_SEARCH_MAX_COST_USD=0.03
# EXA_SEARCH_TYPE=auto
# TAVILY_API_KEY=
# TAVILY_USD_PER_CREDIT=
# Coding sandbox (E2B): bash, files and search for the agent.
# E2B_API_KEY=
# Tracing (Neatlogs); see docs/neatlogs.md. Metadata only unless you opt in to content capture.
# NEATLOGS_API_KEY=
# Lets people save tokens and sign in to plugins (Plugins page). At least 32 random characters.
# PLUGIN_ENCRYPTION_KEY=
