# Copy this file to .env at the repository root for local development.
# apps/api/.env can override these values; process environment takes precedence.
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_PUBLIC_BASE_URL=http://localhost:8000
# Comma-separated origins, for example http://localhost:3000,http://localhost:3001.
ALLOWED_ORIGINS=http://localhost:3000

# Local development placeholders; match the PostgreSQL credentials you configure.
DATABASE_URL=postgresql+psycopg://agentforge:change-me@localhost:5432/agentforge
