# Install as /etc/agentforge/runtime.env, mode 0600. Never commit real values.
# Only runtime settings belong in this file; admin credentials belong in deploy.env.
# Everything not listed here keeps its default; the full reference is docs/configuration.md.
APP_ENV=production
APP_BASE_URL=https://REPLACE_WITH_DOMAIN
API_PUBLIC_BASE_URL=https://REPLACE_WITH_DOMAIN
DATABASE_URL=postgresql+psycopg://agentforge:REPLACE_WITH_DISTINCT_RANDOM_URL_SAFE_PASSWORD@db:5432/agentforge
RESEARCH_STORAGE_PATH=/data/artifacts

# Sign-in. AgentForge has no usage limits, so who may sign in is the access control. With GITHUB_ALLOWED_LOGINS set
# (comma-separated GitHub logins), only those people can sign in, and they get an account on first sign-in.
# PUBLIC_SIGNUP_ENABLED=true with an empty allowlist would let any GitHub user create an account.
AUTH_MODE=github_app
PUBLIC_SIGNUP_ENABLED=false
GITHUB_ALLOWED_LOGINS=REPLACE_WITH_GITHUB_LOGINS

# GitHub App: see docs/github-app.md. User tokens are used; no installation private key is needed.
# The callback URL defaults to API_PUBLIC_BASE_URL + /api/v1/auth/github/callback (what the App is registered with).
GITHUB_APP_ID=REPLACE_WITH_APP_ID
GITHUB_APP_SLUG=REPLACE_WITH_APP_SLUG
GITHUB_CLIENT_ID=REPLACE_WITH_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
GITHUB_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
GITHUB_WEBHOOK_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Model (required to chat). Configure a verified model, its tool/JSON support, context window and current prices
# before opening the app to people.
# LLM_MODEL=
# LLM_API_KEY=
# LLM_SUPPORTS_TOOLS=true
# LLM_SUPPORTS_JSON=true
# LLM_CONTEXT_WINDOW_TOKENS=
# LLM_INPUT_USD_PER_MILLION=
# LLM_OUTPUT_USD_PER_MILLION=

# Capabilities. Each key switches one on; leave it out and that tool is simply unavailable to the agent.
# Web search. Exa is used first; Tavily is the fallback when Exa is unavailable. Either key alone also works.
# Each takes one key or several separated by commas (EXA_API_KEY=key1,key2): they are used in order, and a key that is
# expired, out of credit or rate limited is skipped for a while in favour of the next.
# EXA_API_KEY=
# EXA_SEARCH_MAX_COST_USD=0.03
# EXA_SEARCH_TYPE=auto
# TAVILY_API_KEY=
# TAVILY_USD_PER_CREDIT=
# Coding sandbox (E2B): bash, files and search. The default image has git, Python and Node; set E2B_TEMPLATE_ID only for a
# custom template built and qualified as in infra/e2b.
# E2B_API_KEY=
# Tracing (Neatlogs, docs/neatlogs.md): a project key traces every task. The default sends metadata only (no prompts, answers
# or tool data); NEATLOGS_CAPTURE_CONTENT=true sends them too, so private conversations reach Neatlogs. Choose deliberately.
# NEATLOGS_API_KEY=
# NEATLOGS_TAGS=production
# Lets people save tokens and sign in to plugins; omit to keep plugins that need no token only.
# PLUGIN_ENCRYPTION_KEY=
