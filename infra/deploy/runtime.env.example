# Install as /etc/agentforge/runtime.env, mode 0600. Never commit real values.
# Only runtime settings belong in this file; admin credentials belong in deploy.env.
APP_ENV=production
APP_BASE_URL=https://REPLACE_WITH_DOMAIN
API_PUBLIC_BASE_URL=https://REPLACE_WITH_DOMAIN
ALLOWED_ORIGINS=https://REPLACE_WITH_DOMAIN
DATABASE_URL=postgresql+psycopg://agentforge:REPLACE_WITH_DISTINCT_RANDOM_URL_SAFE_PASSWORD@db:5432/agentforge
LANGGRAPH_CHECKPOINT_DB_URL=postgresql://agentforge:REPLACE_WITH_DISTINCT_RANDOM_URL_SAFE_PASSWORD@db:5432/agentforge
RESEARCH_STORAGE_PATH=/data/artifacts
AUTH_MODE=github_app
PUBLIC_SIGNUP_ENABLED=false
ENABLE_GITHUB_WRITES=false
GITHUB_APP_ID=0
GITHUB_APP_SLUG=REPLACE_WITH_APP_SLUG
GITHUB_CLIENT_ID=REPLACE_WITH_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
GITHUB_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
GITHUB_WEBHOOK_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
GITHUB_OAUTH_CALLBACK_URL=https://REPLACE_WITH_DOMAIN/api/v1/auth/github/callback
# GitHub authorization uses user tokens; no installation private key is needed.
PUBLIC_MAX_CONCURRENT_TASKS=2
PUBLIC_MAX_DAILY_TASKS=20
PUBLIC_MAX_DAILY_COST_USD=5
PUBLIC_MAX_TASK_COST_USD=1
GLOBAL_MAX_CONCURRENT_TASKS=10
GLOBAL_MAX_DAILY_TASKS=100
GLOBAL_MAX_DAILY_COST_USD=20
WORKER_LEASE_SEC=90
WORKER_HEARTBEAT_SEC=10
# Providers are intentionally absent. Configure verified model name, tool/JSON
# support, context/output bounds and current pricing before opening task intake.
# Keep managed E2B. Set E2B_API_KEY / E2B_TEMPLATE_ID only after infra/e2b qualification.
