# Install as /etc/agentforge/deploy.env, mode 0600. Never pass this as app env_file.
# Compose interpolation and migration/bootstrap only; API/worker do not receive admin credentials.
RELEASE_TAG=REPLACE_WITH_REVIEWED_COMMIT
DATA_ROOT=/srv/agentforge
TLS_ROOT=/etc/agentforge/tls
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD
RUNTIME_DATABASE_PASSWORD=REPLACE_WITH_DISTINCT_RANDOM_URL_SAFE_PASSWORD
MIGRATION_DATABASE_URL=postgresql+psycopg://agentforge_admin:REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD@db:5432/agentforge
MIGRATION_CHECKPOINT_DB_URL=postgresql://agentforge_admin:REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD@db:5432/agentforge
RUNTIME_ENV_FILE=/etc/agentforge/runtime.env
